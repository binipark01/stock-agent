# Copy this to a local .env and fill real values. Do not commit real tokens/chat IDs.
# One bot token can send to both rooms as long as the bot is added to both chats.
TELEGRAM_BOT_TOKEN=change-me

# us-stock-agent uses TELEGRAM_US_CHAT_ID by default.
TELEGRAM_US_CHAT_ID=change-me
# TELEGRAM_US_THREAD_ID=optional-topic-id

# kr-stock-agent uses TELEGRAM_KR_CHAT_ID by default.
TELEGRAM_KR_CHAT_ID=change-me
# TELEGRAM_KR_THREAD_ID=optional-topic-id

# Shared fallback if a market-specific value is missing.
# TELEGRAM_CHAT_ID=change-me

TELEGRAM_FALLBACK_IPS=149.154.166.110,149.154.167.220
TELEGRAM_PREFER_FALLBACK_IPS=1
TELEGRAM_NOTIFY_TIMEOUT=10
