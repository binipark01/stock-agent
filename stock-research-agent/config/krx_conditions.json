{
  "manju_close_bet": {
    "name": "만쥬식 종가배팅",
    "description": "주도테마/거래대금/고점권/수급/뉴스 지속성을 묶어 종가배팅 후보를 고른다.",
    "filters": [
      {
        "label": "거래대금 100위 이내",
        "field": "trade_value_rank",
        "op": "<=",
        "value": 100
      },
      {
        "label": "당일 +3% 이상",
        "field": "change_pct",
        "op": ">=",
        "value": 3
      },
      {
        "label": "종가/현재가 고점권",
        "field": "close_position_pct",
        "op": ">=",
        "value": 70
      },
      {
        "label": "테마 강도 확인",
        "field": "theme_strength_score",
        "op": ">=",
        "value": 2
      },
      {
        "label": "프로그램 순매수",
        "field": "program_net_buy",
        "op": ">",
        "value": 0
      },
      {
        "any": [
          {
            "label": "외국인 순매수",
            "field": "foreign_net_buy",
            "op": ">",
            "value": 0
          },
          {
            "label": "기관 순매수",
            "field": "institution_net_buy",
            "op": ">",
            "value": 0
          }
        ]
      }
    ],
    "exclude": [
      {
        "label": "관리종목",
        "field": "is_management_stock",
        "op": "==",
        "value": true
      },
      {
        "label": "투자주의/경고",
        "field": "is_investment_warning",
        "op": "==",
        "value": true
      },
      {
        "label": "가격상승/수급이탈",
        "field": "price_up_flow_divergence",
        "op": "==",
        "value": true
      },
      {
        "label": "프로그램 강매도",
        "field": "program_net_buy",
        "op": "<",
        "value": -500000
      }
    ],
    "score": [
      {
        "label": "거래대금 30위 이내",
        "field": "trade_value_rank",
        "op": "<=",
        "value": 30,
        "points": 3
      },
      {
        "label": "대장주 1순위",
        "field": "theme_leader_rank",
        "op": "==",
        "value": 1,
        "points": 3
      },
      {
        "label": "주도테마 강함",
        "field": "theme_strength_score",
        "op": ">=",
        "value": 3,
        "points": 3
      },
      {
        "label": "고점권 유지",
        "field": "close_position_pct",
        "op": ">=",
        "value": 85,
        "points": 2
      },
      {
        "label": "외국인 순매수",
        "field": "foreign_net_buy",
        "op": ">",
        "value": 0,
        "points": 2
      },
      {
        "label": "기관 순매수",
        "field": "institution_net_buy",
        "op": ">",
        "value": 0,
        "points": 2
      },
      {
        "label": "프로그램 순매수",
        "field": "program_net_buy",
        "op": ">",
        "value": 0,
        "points": 2
      },
      {
        "label": "뉴스 모멘텀",
        "field": "news_momentum",
        "op": ">=",
        "value": 1,
        "points": 2
      }
    ],
    "labels": [
      {
        "min_score": 15,
        "label": "종가베팅 후보"
      },
      {
        "min_score": 10,
        "label": "관찰/소액"
      },
