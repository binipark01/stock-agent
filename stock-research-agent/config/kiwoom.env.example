# Copy this file to config/kiwoom.env and fill real values locally.
# Do NOT commit config/kiwoom.env.

# Recommended split:
# - DATA/prod: read-only market data, quotes, order book, investor/program flow, rankings.
# - TRADE/mock: paper/mock order testing. Live order routing must remain a separate explicit opt-in.
KIWOOM_DATA_ENV=prod
KIWOOM_TRADE_ENV=mock

# Production/read-only market-data credentials issued from https://openapi.kiwoom.com
KIWOOM_PROD_APPKEY=replace_with_prod_appkey
KIWOOM_PROD_SECRETKEY=replace_with_prod_secretkey
KIWOOM_DATA_TOKEN_CACHE=data/kiwoom_token_prod.json

# Mock/paper trading credentials issued from https://openapi.kiwoom.com
KIWOOM_MOCK_APPKEY=replace_with_mock_appkey
KIWOOM_MOCK_SECRETKEY=replace_with_mock_secretkey
KIWOOM_TRADE_TOKEN_CACHE=data/kiwoom_token_mock.json

# Backward-compatible legacy single-env variables still work, but new code should prefer the split above.
# KIWOOM_ENV=mock
# KIWOOM_APPKEY=replace_with_appkey
# KIWOOM_SECRETKEY=replace_with_secretkey
# KIWOOM_TOKEN_CACHE=data/kiwoom_token.json

# Optional later, only needed if/when account/order APIs are added.
# KIWOOM_ACCOUNT_NO=
